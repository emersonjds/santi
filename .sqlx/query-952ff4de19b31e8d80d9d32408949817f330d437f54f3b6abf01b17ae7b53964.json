  "query": "SELECT i.id, p.archived_at IS NOT NULL AS \"archived!\"\n           FROM issue i\n           JOIN project p ON p.id = i.project_id AND p.trashed_at IS NULL\n           JOIN member m ON m.project_id = p.id AND m.user_id = $1\n           WHERE p.key = $2 AND i.number = $3",
