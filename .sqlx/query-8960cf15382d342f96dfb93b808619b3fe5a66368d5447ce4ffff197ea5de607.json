  "query": "SELECT s.id, s.category AS \"category: StatusCategory\", s.column_id\n           FROM status s JOIN board_column c ON c.id = s.column_id\n           WHERE s.project_id = $1 AND s.category = 'todo'\n           ORDER BY c.position, s.id\n           LIMIT 1",
