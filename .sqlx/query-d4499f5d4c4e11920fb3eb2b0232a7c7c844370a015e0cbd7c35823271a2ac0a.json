  "query": "SELECT id, COALESCE(client, 'Unknown device') AS \"client!\", created_at, last_used_at,\n                  id = $2 AS \"current!\"\n           FROM auth_token\n           WHERE user_id = $1 AND kind = 'session' AND expires_at > now()\n           ORDER BY last_used_at DESC, id DESC",
