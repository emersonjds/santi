{
  "db_name": "PostgreSQL",
  "query": "SELECT p.key || '-' || i.number AS \"issue_key!\", c.author_id, c.body, c.created_at\n           FROM issue_comment c\n           JOIN issue i ON i.id = c.issue_id\n           JOIN project p ON p.id = i.project_id\n           WHERE i.project_id = $1\n           ORDER BY c.id",
