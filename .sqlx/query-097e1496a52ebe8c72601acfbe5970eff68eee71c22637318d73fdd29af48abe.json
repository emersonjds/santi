  "query": "SELECT p.id, p.key, p.name, b.board_type AS \"board_type: BoardType\", m.role AS \"role: MemberRole\"\n           FROM member m\n           JOIN project p ON p.id = m.project_id\n           JOIN board b ON b.project_id = p.id\n           WHERE m.user_id = $1\n           ORDER BY p.key",
