{
  "name": "santi-web",
  "private": true,
  "version": "0.25.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"const fs = require('node:fs'); fs.renameSync('dist/.vite/manifest.json', 'node_modules/.tmp/vite-manifest.json'); fs.rmSync('dist/.vite', { recursive: true })\"",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --browser.headless",
    "test:coverage": "vitest run --coverage --browser.headless",
    "gen:api": "openapi-typescript openapi.json -o src/shared/api/schema.d.ts",
    "e2e": "playwright test",
    "size": "size-limit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
